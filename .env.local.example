# Contact form email (Gmail SMTP). Email sending activates only when both are set.
SMTP_USER=
SMTP_PASS=

# Google Analytics 4 (GA4). Optional: when unset the site falls back to the
# measurement ID G-V9W1PD2NDW baked into the GoogleAnalytics component.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-V9W1PD2NDW

# Cloudflare Turnstile bot protection for the contact form. The server secret
# enables verification; while it is unset the endpoint fails open and accepts.
TURNSTILE_SECRET=
# Comma separated hostname allowlist. Leave unset or empty to skip the check.
# Add localhost (and 127.0.0.1) when developing locally, and make sure the
# widget is registered for that hostname too, or localhost submits get a 403.
TURNSTILE_HOSTNAMES=bivekgurung.com,www.bivekgurung.com
# Public site key for the widget. Optional: when unset the site falls back to
# the value baked into the Contact component.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE-1qMMz6WJgOOy_
